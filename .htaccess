<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Prevent caching of index.html so new deployments are picked up immediately
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # --- Security headers (added 2026-07 review) -----------------------------
  # CSP: no inline/remote scripts. connect/img allow the Supabase backend +
  # storage + realtime websocket. Fonts are self-hosted (src/fonts.css,
  # public/fonts/), so style/font stay 'self' — no visitor IPs go to Google.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"

  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  # no-referrer keeps the forum URL from leaking to third-party sites users click through to
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  # Enable once the site is served exclusively over HTTPS (Metanet)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
